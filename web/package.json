{
  "name": "rcp-web",
  "private": true,
  "version": "0.4.34",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:same-origin": "RCP_DESKTOP_FRONTEND_URL=http://127.0.0.1:8421 tauri dev --no-dev-server --no-dev-server-wait --config src-tauri/tauri.same-origin.conf.json",
    "desktop:build-dev": "sh src-tauri/scripts/build-dev.sh",
    "desktop:prepare-sidecar": "sh src-tauri/scripts/prepare-sidecar.sh",
    "desktop:build": "sh src-tauri/scripts/build-release.sh",
    "desktop:build-signed": "sh src-tauri/scripts/build-release.sh --updater",
    "build": "tsc -b && vite build",
    "build:clean": "tsc -b && vite build --emptyOutDir",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror-lang-typst": "0.6.0",
    "d3-force": "^3.0.0",
    "katex": "^0.18.10",
    "lib0": "0.2.119",
    "lucide-react": "^0.525.0",
    "pdfjs-dist": "6.4.299",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "^6.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.4",
    "y-protocols": "1.0.7"
  },
  "overrides": {
    "katex": "$katex"
  }
}
