{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rcp",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "rcp", "serve", "--host", "127.0.0.1", "--port", "8421"],
      "port": 8421
    },
    {
      "name": "rcp-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "rcp-desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "desktop:dev"],
      "port": 5173
    },
    {
      "name": "rcp-desktop-same-origin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "desktop:same-origin"],
      "port": 8421
    }
  ]
}
