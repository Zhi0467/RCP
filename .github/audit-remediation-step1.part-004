+        native_session_id="worker-session",
+        stage_root=str(stage),
+    )
+    background = BackgroundAgentTasks(store, _successful_stream)
+    signals: list[str] = []
+    monkeypatch.setattr(background, "_signal_agent_task_pause", signals.append)
+    original_request_stop = store.request_auto_research_child_work_stop
+
+    def advance_route_then_stop(worker_id: str):
+        request = RunRequest.model_validate(worker.request).model_copy(
+            update={"session_id": worker.native_session_id}
+        )
+        now = store.now()
+        raced = AgentTaskRecord(
+            operation_id="worker-raced-at-stop",
+            project_id=worker.project_id,
+            episode_id=worker.episode_id,
+            graph_target=worker.graph_target,
+            kind="node_chat",
+            status="queued",
+            request=request.model_dump(mode="json"),
+            created_at=now,
+            updated_at=now,
+            status_message="raced current attempt",
+            attempt=worker.attempt + 1,
+            parent_operation_id=worker.operation_id,
+            native_session_id=worker.native_session_id,
+            stage_host=worker.stage_host,
+            stage_root=worker.stage_root,
+            authorized_by=worker.authorized_by,
+            dispatch_authority=worker.dispatch_authority,
+        )
+        store.create_auto_research_child_work_recovery(worker_id, raced)
+        return original_request_stop(worker_id)
+
+    monkeypatch.setattr(store, "request_auto_research_child_work_stop", advance_route_then_stop)
+
+    stopped = stop_auto_research_child_work(
+        background,
+        auto_research.episode_id,
+        worker.operation_id,
+    )
+
+    route = store.auto_research_child_work(worker.operation_id)
+    assert route is not None
+    assert route.current_operation_id == "worker-raced-at-stop"
+    assert route.stop_requested_at is not None
+    assert stopped.operation_id == "worker-raced-at-stop"
+    assert stopped.status == "pausing"
+    assert signals == ["worker-raced-at-stop"]
+
+
+def test_admission_exhaustion_logs_a_failed_wrapup_hook(tmp_path, caplog) -> None:
+    store, auto_research, _root = _setup_auto_research(tmp_path)
+
+    def broken_hook(_episode: EpisodeRecord) -> None:
+        raise RuntimeError("wrap-up dispatch failed")
+
+    background = BackgroundAgentTasks(
+        store,
+        _successful_stream,
+        on_auto_research_admission_exhausted=broken_hook,
+    )
+
+    with caplog.at_level(logging.ERROR, logger="rcp.runs.auto_research_admission"):
+        auto_research_admission_exhausted(background, auto_research)
+
+    assert "Auto-research admission-exhaustion hook failed" in caplog.text
+    assert "wrap-up dispatch failed" in caplog.text
+
+
+def _child_work_watcher(
+    store: AppStore,
+    worker: AgentTaskRecord,
+    *,
+    watcher_id: str,
+    status: str,
+) -> GraphWatcherRecord:
+    now = store.now()
+    return GraphWatcherRecord(
+        watcher_id=watcher_id,
+        project_id=worker.project_id,
+        origin_operation_id=worker.operation_id,
+        origin_task_kind="node_chat",
+        chat_id=str(worker.request["chat_id"]),
+        node_id=str(worker.request["node_id"]),
+        episode_id=worker.episode_id,
+        graph_target=worker.graph_target,
+        continuation=WatcherContinuation(
+            provider="codex",
+            run_on="local",
+            run_truth_scope=_RUN_TRUTH_SCOPE,
+            patch_kind="work",
+        ),
+        condition={"node_id": "blk/check", "status_in": ["resolved"]},
+        armed_revision=1,
+        status=status,
+        created_at=now,
+        last_evaluated_at=now,
+        completed_at=now if status == "completed" else None,
+    )
+
+
+def test_stop_settlement_follows_child_work_attempt_lineage(tmp_path) -> None:
+    store, auto_research, root = _setup_auto_research(tmp_path)
+    worker = _create_routed_worker(store, auto_research, root, status="succeeded")
+    watcher = _child_work_watcher(
+        store,
+        worker,
+        watcher_id="child-work-watcher-before-stop",
+        status="active",
+    )
+    store.create_watchers([watcher])
+    # Recreate the pre-fix shape: child Work omitted its parent episode on the watcher.
+    with store.connection() as connection:
+        connection.execute(
+            "UPDATE watchers SET episode_id = NULL WHERE watcher_id = ?",
+            (watcher.watcher_id,),
+        )
+
+    store.request_episode_stop(auto_research.episode_id)
+    assert store.settle_auto_research_watchers(auto_research.episode_id) == 1
+
+    stopped = store.watcher(watcher.watcher_id)
+    assert stopped is not None
+    assert stopped.status == "stopped"
+    assert stopped.notified is True
+
+
+def test_late_child_work_watcher_delivery_is_fenced_by_parent_episode(tmp_path) -> None:
+    store, auto_research, root = _setup_auto_research(tmp_path)
+    worker = _create_routed_worker(store, auto_research, root, status="succeeded")
+    watcher = _child_work_watcher(
+        store,
+        worker,
+        watcher_id="late-child-work-watcher",
+        status="completed",
+    )
+    store.create_watchers([watcher])
+    store.request_episode_stop(auto_research.episode_id)
+
+    request = RunRequest.model_validate(worker.request).model_copy(
+        update={"trigger": "watcher", "watcher_ids": [watcher.watcher_id]}
+    )
+    authority = resolve_dispatch_authority("node_chat", request)
+    assert authority is not None
+    now = store.now()
+    wake = AgentTaskRecord(
+        operation_id="late-child-work-wake",
+        project_id=worker.project_id,
+        episode_id=auto_research.episode_id,
+        graph_target=worker.graph_target,
+        kind="node_chat",
+        status="queued",
+        request=request.model_dump(mode="json"),
+        created_at=now,
+        updated_at=now,
+        status_message="late watcher wake",
+        authorized_by=worker.authorized_by,
+        dispatch_authority=authority,
+    )
+
+    assert store.create_watcher_notification_task(wake, [watcher.watcher_id]) is None
+    assert store.agent_task(wake.operation_id) is None
+    stopped = store.watcher(watcher.watcher_id)
+    assert stopped is not None
+    assert stopped.status == "stopped"
+    assert stopped.notified is True
+
